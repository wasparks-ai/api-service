# wasparks-api-service — example environment file.
# Copy to api-service.env and fill in real values for prod. Every variable has a dev-safe default
# baked into application.yml, so a local run needs none of this (see README.md "Running it locally").

# --- Database (shared with admin-service and tenants-service) ---
DB_URL=jdbc:postgresql://localhost:5432/whatsapp_admin
DB_USERNAME=postgres
DB_PASSWORD=admin123

# --- Redis (the only Redis in the estate) ---
REDIS_URL=redis://localhost:6379

# --- Shared secrets — MUST match tenants-service and/or admin-service exactly in prod ---
ENCRYPTION_SECRET=your-aes-256-encryption-key-32c
TENANTS_JWT_SECRET=
INTERNAL_API_SECRET=

# --- Upstream ---
TENANTS_SERVICE_BASE_URL=http://localhost:8081
API_PUBLIC_BASE_URL=http://localhost:8083

# --- Browser CORS on /v1/** (tenant-web). /meta/** stays CORS-disabled regardless of this value.
# Comma-separated. Dev: http://localhost:5173. Prod: https://app.wasparks.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Send queue / workers ---
SEND_WORKERS=8
SEND_STREAM=sends
SEND_STREAM_MAXLEN=100000
SEND_RETRY_BACKOFF_MS=2000,10000,30000

# --- Misc ---
API_PREFLIGHT_ENABLED=true
INTERNAL_TIMEOUT_MS=10000
API_KEY_CACHE_TTL_SECONDS=300
WEBHOOK_RETRY_BACKOFF_MS=10000,60000,300000,1800000,7200000
WEBHOOK_PAUSE_AFTER_FAILURES=100
USAGE_FLUSH_MS=600000
